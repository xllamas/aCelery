<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later: what goes into a Google backup and a phone-to-phone
  transfer. Everything the user made travels (apps, databases, files) but
  not the access store: it holds the network devices' and MCP clients' bearer
  tokens in the clear (lib/src/paths.dart accessStore), and restored onto a new
  phone they would still be valid keys to the whole tree. After a restore,
  sharing is off and every client pairs again.

  app_flutter is path_provider's documents directory on Android. The aCelery
  cache is scratch for exported zips, and not worth the space.

  backup_rules.xml says the same for Android 11 and older.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/.acelery/" />
        <exclude domain="root" path="app_flutter/aCelery/cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/.acelery/" />
        <exclude domain="root" path="app_flutter/aCelery/cache/" />
    </device-transfer>
</data-extraction-rules>
